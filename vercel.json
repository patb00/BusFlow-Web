{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/hr/index.html", "destination": "/hr/", "permanent": true },
    { "source": "/en/index.html", "destination": "/en/", "permanent": true },
    { "source": "/kontakt/index.html", "destination": "/kontakt/", "permanent": true },
    { "source": "/hr", "destination": "/hr/", "permanent": true },
    { "source": "/en", "destination": "/en/", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "hr" }], "destination": "/hr/", "permanent": false },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "en" }], "destination": "/en/", "permanent": false },
    { "source": "/demo", "has": [{ "type": "query", "key": "lang", "value": "hr" }], "destination": "/hr/#demo", "permanent": false },
    { "source": "/demo", "has": [{ "type": "query", "key": "lang", "value": "en" }], "destination": "/en/#demo", "permanent": false },
    { "source": "/demo", "destination": "/#demo", "permanent": false },
    { "source": "/klijenti/:path*", "has": [{ "type": "query", "key": "lang", "value": "hr" }], "destination": "/hr/#referenca", "permanent": false },
    { "source": "/klijenti/:path*", "has": [{ "type": "query", "key": "lang", "value": "en" }], "destination": "/en/#reference", "permanent": false },
    { "source": "/klijenti/:path*", "destination": "/#referenz", "permanent": false },
    { "source": "/impressum", "destination": "/impressum.html", "permanent": false },
    { "source": "/datenschutz", "destination": "/datenschutz.html", "permanent": false },
    { "source": "/hr/impresum", "destination": "/hr/impresum.html", "permanent": false },
    { "source": "/hr/privatnost", "destination": "/hr/privatnost.html", "permanent": false },
    { "source": "/en/legal-notice", "destination": "/en/legal-notice.html", "permanent": false },
    { "source": "/en/privacy", "destination": "/en/privacy.html", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'sha256-J5vLA3LUo1TuA3VtCDcwqRP0sBrTgLcX9Z4Gr3pDkUk=' 'sha256-8KSa1XRMXWKV7x8ycNcwR1105V+zeu3DH46vV1CJUoI=' 'sha256-kAqsM9uXW85advf05PYlJTteEPsINZKNTeNabDPDKsw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://photon.komoot.io https://router.project-osrm.org https://formspree.io; form-action 'self'; base-uri 'none'; frame-ancestors 'none'" }
    ] },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(img|vendor|data)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}

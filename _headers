# Cloudflare Pages: zaglavlja odgovora (build ih kopira u dist/). CSP provjerava npm run lint, vidi README → Objava.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com 'sha256-J5vLA3LUo1TuA3VtCDcwqRP0sBrTgLcX9Z4Gr3pDkUk=' 'sha256-8KSa1XRMXWKV7x8ycNcwR1105V+zeu3DH46vV1CJUoI=' 'sha256-kAqsM9uXW85advf05PYlJTteEPsINZKNTeNabDPDKsw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://photon.komoot.io https://router.project-osrm.org https://formspree.io; form-action 'self'; base-uri 'none'; frame-ancestors 'none'

# pregledi i adresa projekta na pages.dev ne ulaze u tražilice; kanonska adresa je https://busflow.email
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
